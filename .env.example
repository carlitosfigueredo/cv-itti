VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Opcional: "true" para conectar a los emuladores locales
VITE_USE_EMULATORS=false

# Textos legales: nombre del responsable de la plataforma y email de contacto
# para consultas y ejercicio de derechos sobre datos personales.
VITE_LEGAL_OWNER=
VITE_LEGAL_CONTACT_EMAIL=

# App Check con reCAPTCHA Enterprise (clave de sitio, publica). Si falta, App Check
# no se activa (util en local). Con los emuladores no se usa.
VITE_APPCHECK_SITE_KEY=
